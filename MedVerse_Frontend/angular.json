{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "healthcare-app": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/healthcare-app",
      "sourceRoot": "projects/healthcare-app/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/healthcare-app",
            "index": "projects/healthcare-app/src/index.html",
            "browser": "projects/healthcare-app/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/healthcare-app/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/healthcare-app/public"
              },
              {
                "glob": "**/*",
                "input": "UI reference and elements",
                "output": "ui-reference-elements"
              },
              {
                "glob": "**/*",
                "input": "shared-assets",
                "output": "shared-assets"
              }
            ],
            "styles": [
              "projects/healthcare-app/src/styles.css"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "10kB",
                  "maximumError": "14kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "healthcare-app:build:production"
            },
            "development": {
              "buildTarget": "healthcare-app:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "projects/healthcare-app/tsconfig.spec.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/healthcare-app/public"
              },
              {
                "glob": "**/*",
                "input": "shared-assets",
                "output": "shared-assets"
              }
            ],
            "styles": [
              "projects/healthcare-app/src/styles.css"
            ],
            "scripts": []
          }
        }
      }
    },
